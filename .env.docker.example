# variables d'environment pour l'authentification de l'image MySQL
DATABASE_URL=mysql://symfony:change_me_mysql@mysql:3306/vitegourmand?serverVersion=8.0.32&charset=utf8mb4
MYSQL_DATABASE=vitegourmand
MYSQL_USER=symfony
MYSQL_PASSWORD=change_me_mysql
MYSQL_ROOT_PASSWORD=change_me_mysql_root
# variables d'environment pour l'authentification de l'image MongoDB
MONGODB_URI=mongodb://symfony:change_me_mongo@mongodb:27017/?authSource=admin
MONGO_INITDB_ROOT_USERNAME=symfony
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo
MONGODB_DB=vitegourmand
# Mailer_DSN
MAILER_DSN=smtp://mon_email@gmail.com:mon_mot_de_passe@mon_smtp_serveur:587
MAILER_FROM_ADDRESS=change_me
MAILER_FROM_NAME=change_me