{% extends 'base.html.twig' %}

{% block title %} Modification commande {% endblock title %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="/css/pages/utilisateur/modifier-commande.css">
{% endblock stylesheets %}

{% block content %}

    <div class="modifierCommandeFormulaire">

        <h3>Modifier ma commande</h3>

        <p>Menu : <span class="color">{{ commande.menu.titre }}</span></p>
        <p>
            Une fois votre commande validée, seules la date et l’heure de livraison peuvent être modifiées directement
            depuis votre espace personnel.
        </p>
        <p>
            <span class="TextColor">Pour toute autre demande de modification</span>, nous vous invitons à nous <b>contacter par téléphone ou via l’onglet
            Contact</b>. En raison de la préparation de produits frais, de l’organisation des commandes et de la facturation,
            certaines modifications peuvent impacter le bon déroulement de la préparation et de la livraison.
        </p>
        <p>Merci de votre compréhension</p>

        {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="flash-{{ label }}">
            {{ message }}
        </div>
        {% endfor %}
        {% endfor %}

        {{ form_start(form) }}

        {# Date de livraison #}
        {{ form_label(form.datePrestation) }}
        {{ form_widget(form.datePrestation) }}

        {# Heure de livraison #}
        {{ form_label(form.heureLivraison) }}
        {{ form_widget(form.heureLivraison) }}

        <button type="submit">Enregistrer</button>

        {{ form_end(form) }}

        <a href="{{ path('app_utilisateur_commandes_en_cours', {id: commande.id}) }}">Retour</a>

    </div>

{% endblock content %}