{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/utilisateur/information-commande.css">
{% endblock stylesheets %}

{% block title %} Mes commandes {% endblock title %}

{% block content %}

    <div class="divMaCommande">
        
        <h3>Commande en cours</h3>
        
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        
        {% for commande in commandeEnCours %}
        
        <div>
            <p> Menu : {{ commande.menu.titre }} </p>
            <p> Date de création : {{ commande.dateCmd|date('d/m/Y') }} </p>
            <p> {{ commande.prixMenu }} €</p>
            <p> Statut de la commande : {{ commande.statut }} </p>
            <a href="{{ path('app_utilisateur_commandes_en_cours', {id: commande.id}) }}">Détail de ma commande</a>
            <br>
            <a href="{{ path('app_utilisateur_annuler_commande', {id: commande.id}) }}">Annuler ma commande</a>
        </div>
        
        {% else %}
            <p>Vous n'avez pas de commande en cours</p>
        {% endfor %}
        
    </div>

    <h3 class="divMesCommandesH3">Commande terminée</h3>
    
    <div class="divMesCommandes">
        
        {% for commande in commandes %}
            <div class="commandeHistorique">
                <p> {{ commande.dateCmd|date('d/m/Y') }} - {{ commande.menu.titre }}
                    <a title="Détail de la commande" href="{{ path('app_utilisateur_commandes_en_cours', {id: commande.id}) }}">🔍</a></p>
                <p> {{ commande.prixMenu }} €</p>
            </div>
        {% else %}
            <p>Aucun historique de commande</p>
        {% endfor %}

    </div>
        
{% endblock content %}