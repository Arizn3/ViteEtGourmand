{% extends 'base.html.twig' %}

{% block title %} Détail de ma commande {% endblock title %}

{% block content %}

    <h3>Détail de ma commande</h3>
    
    <p>Statut de ma commande : {{ commande.statut }}</p>
    <p>Changement du statut effectué le ?? </p>
    <p>Date : {{ commande.dateCmd|date('d/m/Y') }}</p>
    <p>Date de livraison : {{ commande.datePrestation|date('d/m/Y') }}</p>
    <p>Heure de livraison : {{ commande.heureLivraison|date('H:i') }}</p>
    <p>Adresse : {{ commande.villeLivraison }} - {{ commande.adresseLivraison }}</p>
    <p>Menu : {{ commande.menu.titre }}</p>
    <p>Nombre de boîte à repas : {{ commande.nbPersonne }}</p>
    <p>Prix : {{ commande.prixMenu }} €</p>

    <br>
    {% if commande.statut !== 'Terminer' %}
        <a href="{{ path('app_utilisateur_modifier_commande', {id: commande.id}) }}">Modifier les informations de la commande</a>
        <br>
    {% endif %}
    <a href="{{ path('app_utilisateur_commandes') }}">Retour</a>

{% endblock content %}