{% extends 'base.html.twig' %}

{% block title %} Ajouter ou modifier votre avis {% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/utilisateur/avis-utilisateur.css">
{% endblock stylesheets %}

{% block content %}

    <div class="divAvisUtilisateur">

        {{ form_start(form) }}
        
        {{ form_row(form.note) }}

        <p>Votre avis est limité à 50 caractères maximum.</p>

        {{ form_row(form.libelle) }}
        
        <button>Valider</button>
        
        {{ form_end(form) }}
        
        <a href="{{ path('app_utilisateur_information_personnelle') }}">Retour</a>

    </div>

{% endblock content %}