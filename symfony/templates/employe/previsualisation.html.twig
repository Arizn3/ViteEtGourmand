{% block stylesheets %}
    <link rel="stylesheet" href="/css/pages/menus/menu.css">
{% endblock stylesheets %}

<title> Prévisualisation d'un menu </title>

{% block content %}

    <div class="divMenu">
        
        {% set plat = menu.plats|first %}
        {% set allAllergenes = [] %}
        
        <div class="divPhotos">    
            
            <img id="photo" src="/uploads/plats/{{ menu.plats|first.photo }}" class="photo">
            
            <div class="gallerie">
                
                {% for plat in menu.plats %}
                    <img src="/uploads/plats/{{ plat.photo }}" class="photos">
                {% endfor %}
                
            </div>

        </div>

        <div class="divDetail">

            <h3><b>{{ menu.titre }}</b></h3>

            <p class="themeRegime">{{ menu.theme.description }}</p>
            <p class="themeRegime">{{ menu.regime.description }}</p>

            {% for plat in menu.plats %}
                <p class="plat">{{ plat.nomPlat }}</p>
            {% endfor %}

            <p class="description">{{ menu.description }}</p>

            {% for plat in menu.plats %}
                {% for allergene in plat.allergenes %}
                    {% if allergene.description not in allAllergenes %}
                        {% set allAllergenes = allAllergenes|merge([allergene.description]) %}
                    {% endif %}
                {% endfor %}
            {% endfor %}

            <p class="allergeneTitre"><u>Allergènes présents dans le menu :</u></p>

            <ul>
                {% for a in allAllergenes %}
                    <p class="allergenes">‣ <b>{{ a }}</b></p>
                {% endfor %}
            </ul>

            <p class="pr">● <b>{{ menu.prixPersonne }}€</b> par personne</p>
            <p class="nb">● À partir de <b>{{ menu.personneMini }}</b> boîte à repas</p>
            <p class="qtt">● <b>{{ menu.qttRestante }}</b> quantités disponibles</p>

            <div class="btn">
                <a href="#">Liste des menus</a>
                <a href="#">Commander</a>
            </div>
            
            <a href="{{ path('app_employe_gestion_menu') }}">Retour</a>

        </div>

    </div>

{% endblock content %}

{% block javascripts %}
    <script src="/javascript/pages/menus/menu.js"></script>
{% endblock javascripts %}