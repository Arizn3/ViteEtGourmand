{% extends 'base.html.twig' %}

{% block title %} Nouveau thème {% endblock title %}

{% block content %}

    {# Nom du compte employé connecté #}
    <p> Compte : {{ app.user.userIdentifier }}</p>

    <h3>Création d'un nouveau thème</h3>
    <a href="{{ path('app_employe_gestion_menu') }}">retour</a>
    <br><br>

    {{ form_start(form) }}

    {# Nom du thème #}
    {{ form_label(form.description) }}
    <br>
    {{ form_widget(form.description) }}
    <br><br>

    <button type="submit">Enregistrer</button>
    <br><br>

    {{ form_end(form) }}

    {# Thème disponible #}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <table>
        <tr>
            <th>Thèmes disponibles</th>
        </tr>
        {% for themes in theme %}
        <tr>
            <td>
                {{ themes.description }}
                <a href="{{ path('app_supprime_theme', {id: themes.id}) }}" class="btn-supression">❌
                </a>
            </td>
        </tr>

        {% endfor %}
    </table>

{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    <script src="/javascript/pages/employe-theme.js"></script>
{% endblock javascripts %}