{% extends 'base.html.twig' %}

{% block title %} Nouveau thème {% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/employe/employe-theme.css">
{% endblock stylesheets %}

{% block content %}

    {# Nom du compte employé connecté #}
    <p> Compte : {{ app.user.userIdentifier }}</p>

    <div class="formulaire">

        <h3>Création d'un nouveau thème</h3>
        <a href="{{ path('app_employe_gestion_menu') }}">retour</a>

        {{ form_start(form) }}

        {# Nom du thème #}
        {{ form_label(form.description) }}
        {{ form_widget(form.description) }}

        <button type="submit">Enregistrer</button>

        {{ form_end(form) }}

    </div>

    <div class="listeTheme">

        {# Thème disponible #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <table>

            <tr>
                <th>Thèmes disponibles</th>
            </tr>
            {% for themes in theme %}
                <tr>
                    <td>
                        <a href="{{ path('app_supprime_theme', {id: themes.id}) }}" class="btn-supression" title="Supprimer">❌</a>
                        {{ themes.description }}
                    </td>
                </tr>
            {% endfor %}

        </table>

    </div>

{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    <script src="/javascript/pages/admin/employe-theme.js"></script>
{% endblock javascripts %}