{% extends 'base.html.twig' %}

{% block title %} Nouveau régime {% endblock %}

{% block body %}

    {# Nom du compte employé connecté #}
    <p> Compte : {{ app.user.userIdentifier }}</p>

    <h3>Création d'un nouveau régime</h3>
    <a href="{{ path('app_employe_gestion_menu') }}">Gestion des menus</a>
    <br><br>

    {{ form_start(form) }}

    {# Nom du thème #}
    {{ form_label(form.description) }}
    <br>
    {{ form_widget(form.description) }}
    <br><br>

    <button type="submit">Enregistrer</button>
    <br><br>

    {{ form_end(form) }}

    {# Thème disponible #}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <table>
        <tr>
            <th>Thèmes disponibles</th>
        </tr>
        {% for regimes in regime %}
        <tr>
            <td>
                {{ regimes.description }}
                <a href="{{ path('app_supprime_regime', {id: regimes.id}) }}" class="btn-supression">❌
                </a>
            </td>
        </tr>

        {% endfor %}
    </table>

{% block javascript %}
    <script src="/javascript/employe-regime.js"></script>
{% endblock javascript %}

{% endblock %}