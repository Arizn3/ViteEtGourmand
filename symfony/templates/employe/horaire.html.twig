{% extends 'base.html.twig' %}

{% block title %} Gestion des horaires {% endblock title %}

{% block content %}

    {# Nom du compte employé connecté #}
    <p> Compte : {{ app.user.userIdentifier }}</p>

    <h3>Gestion des horaires</h3>
    <p>Ces horaires sont visibles sur la page d'accueil.</p>

    <table>
        <tr>
            <th>Jour</th>
            <th>Ouverture</th>
            <th>Fermeture</th>
            <th>Modifier</th>
        </tr>

        {% for h in horaires %}
            <tr>
                <td>{{ h.jour }}</td>
                <td>{{ h.heureOuverture|date('H:i') }}</td>
                <td>{{ h.HeureFermeture|date('H:i') }}</td>
                <td>
                    <a href="{{ path('app_employe_nouveau_horaire', {id: h.id}) }}">✏️</a>
                </td>
            </tr>
        {% endfor %}
    </table>

{% endblock content %}