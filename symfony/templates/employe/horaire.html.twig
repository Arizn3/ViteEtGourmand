{% extends 'base.html.twig' %}

{% block title %} Gestion des horaires {% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/employe/employe-horaire.css">
{% endblock stylesheets %}

{% block content %}

    {# Nom du compte employé connecté #}
    <p> Compte : {{ app.user.userIdentifier }}</p>

    <div class="horaireTitre">
        
        <h3>Gestion des horaires</h3>
        <p>Ces horaires sont visibles sur la page d'accueil.</p>
        
    </div>

    <div class="horaireTable">

        <table>
            <tr>
                <th class="horaireJour">Jour</th>
                <th class="horaireOuverture">Ouverture</th>
                <th class="horaireFermeture" >Fermeture</th>
                <th class="horaireModifier">Modifier</th>
            </tr>
            
            {% for h in horaires %}
            <tr>
                <td class="horaireJourTd">{{ h.jour }}</td>
                <td class="horaireOuvertureTd">{{ h.heureOuverture|date('H:i') }}</td>
                <td class="horaireFermetureTd">{{ h.HeureFermeture|date('H:i') }}</td>
                <td class="horaireModifierTd">
                    <a href="{{ path('app_employe_nouveau_horaire', {id: h.id}) }}">✏️</a>
                </td>
            </tr>
            {% endfor %}
        </table>

    </div>

{% endblock content %}