<head>
    <title> Je me connecte </title>
    <link rel="stylesheet" href="/css/pages/home/connexion.css">
    <link rel="icon" href="/uploads/images/logo.png">
</head>

<body>

    <main class="mainFormulaireConnexion">

            <form method="post" novalidate>

                {% if error %}
                <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                <div>
                    <p>Vous êtes connecté sur le compte {{ app.user.userIdentifier }} </p>
                    {# Déconnexion #}
                    <a href="{{ logout_path() }}">Déconnexion</a>
                </div>
                {% endif %}

                <h1>Connexion</h1>

                <div class="emailFormulaire">
                    <label for="inputEmail">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" autocomplete="email"
                    required autofocus>
                </div>

                <div>
                    <label for="inputPassword">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword" autocomplete="current-password" required>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                    value="{{ csrf_token('authenticate') }}">
                </div>

                <div class="btnConnexion">
                    <label>
                        <input type="checkbox" name="_remember_me"> Se souvenir de moi
                    </label>
                    <br>
                    <button type="submit">
                        Se connecter
                    </button>
                </div>
                    
            </form>

            {# Lien de retour sur la page d'accueil #}
            <a href="{{ path('app_home') }}">Accueil</a>
            {# Création d'un compte #}
            <a href="{{ path('app_register') }}">Je crée mon compte</a>
            {# Mot de passe oublier #}
            <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>

    </main>
    
</body>