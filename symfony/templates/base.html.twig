<!DOCTYPE html>
<html>

<head>
    {% block head %}

        <meta charset="UTF-8">

        {% block stylesheets %}
            <link rel="stylesheet" href="/css/navbar.css">
        {% endblock stylesheets %}

        <title>V&G - {% block title %}{% endblock title %}</title>

    {% endblock %}
</head>

<body>
    <header>
        {% include "header.html.twig" %}
    </header>

    <nav>
        {% include "navbar.html.twig" %}
    </nav>

    <main>
        {% block content %}
            {# Contenu des autres pages de l'application #} 
        {% endblock content %}
    </main>

    <footer>
        {% include "footer.html.twig" %}
    </footer>

    {% block javascripts %}
        <script src="/javascript/navbar.js" defer></script>
    {% endblock javascripts %}

</body>

</html>