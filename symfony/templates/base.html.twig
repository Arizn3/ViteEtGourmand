<!DOCTYPE html>
<html>

<head>
    {% block head %}

        <meta charset="UTF-8">

        {% block stylesheets %}
            <link rel="stylesheet" href="/css/layout/navbar.css">
            <link rel="stylesheet" href="/css/layout/header.css">
            <link rel="stylesheet" href="/css/layout/footer.css">
            <link rel="icon" href="/uploads/images/logo.png">
        {% endblock stylesheets %}

        <title>V&G - {% block title %}{% endblock title %}</title>

    {% endblock head %}
</head>

<body>
    <header>
        {% include "layout/header.html.twig" %}
    </header>

    <nav>
        {% include "layout/navbar.html.twig" %}
    </nav>

    <main>
        {% block content %}
            {# Contenu des autres pages de l'application #} 
        {% endblock content %}
    </main>

    <footer>
        {% include "layout/footer.html.twig" %}
    </footer>

    {% block javascripts %}
        <script src="/javascript/layout/navbar.js" defer></script>
    {% endblock javascripts %}

</body>

</html>