{% extends 'base.html.twig' %}

{% block title %} Commande {% endblock %}


{% block body %}

<h1>Commande</h1>

<p>Prix de base : {{ menu.prixPersonne }}</p>
<p>Nombre de personnes minimum : {{ menu.personneMini }}</p>

<form method="post" novalidate>
    
    <label for="nb_personnes">Nombre de personnes :</label>
    {# data- permet de passer des données au fichier JavaScript #}
    <input type="number" id="nb_personnes" name="nb_personnes" data-prix="{{ menu.prixPersonne }}"
    data-min="{{ menu.personneMini }}" min=0 required>
    <br><br>
    {# Balises d'intéraction pour JavaScript #}
    <p id="erreur"></p>
    <p id="prix"></p>
    
    <button type="submit">Valider la commande</button>
    
</form>

<a href="{{ path('app_menu_detail', {id: menu.id}) }}">Retour aux détails</a>

{% block javascript %}
<script src="/javascript/commande.js"></script>
{% endblock javascript %}

{% endblock body %}