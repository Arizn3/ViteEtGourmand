{% extends 'base.html.twig' %}

{% block title %} Commande {% endblock %}


{% block body %}

{% if is_granted('ROLE_EMPLOYE') %}
    <p>Connecter en tant qu'employé</p>
{% endif %}
{% if is_granted('ROLE_ADMIN') %}
    <p>Connecter en tant qu'administrateur</p>
{% endif %}

<h1>Commande</h1>

<p>Prix de base : {{ menu.prixPersonne }}</p>
<p>Nombre de personnes minimum : {{ menu.personneMini }}</p>

{# Formulaire de commande #}
<form method="post" id="form_commande" novalidate>

    <label for="nb_personnes">Nombre de personnes :</label>
    {# data- permet de passer des données au fichier JavaScript #}
    <input type="number" name="nb_personnes" id="nb_personnes" data-prix="{{ menu.prixPersonne }}"
        data-min="{{ menu.personneMini }}" min=0 required>
    <br><br>
    {# Balises d'intéraction pour JavaScript #}
    <p id="erreur"></p>
    <p id="prix"></p>
    <p id="prixTotalLivraison"></p>
    <br>
    <label for="nom">Nom :</label>
    <input type="text" name="nom" value="{{ utilisateur.nom }}" readonly>
    <br>
    <label for="prenom">Prénom :</label>
    <input type="text" name="prenom" value="{{ utilisateur.prenom }}" readonly>
    <br>
    <label for="email">Email :</label>
    <input type="text" name="email" value="{{ utilisateur.email }}" readonly>
    <br>
    <label for="telephone">Telephone :</label>
    <input type="text" name="telephone" value="{{ utilisateur.telephone }}" readonly>
    <br><br>
    <label for="date_prestation">Date de livraison souhaitée :</label>
    <input type="date" name="date_prestation" id="date_prestation" required>
    <label for="heure_livraison">Heure de livraison souhaitée :</label>
    <input type="time" name="heure_livraison" id="heure_livraison" required>
    <label for="ville_livraison">Ville :</label>
    <input type="text" name="ville_livraison" id="ville_livraison" required>
    <label for="adresse_livraison">Adresse de livraison souhaitée :</label>
    <input type="text" name="adresse_livraison" id="adresse_livraison" required>
    <br><br>
    <button type="submit">Valider la commande</button>

</form>

<a href="{{ path('app_menu_detail', {id: menu.id}) }}">Retour aux détails</a>

{% block javascript %}
<script src="/javascript/commande.js" defer></script>
{% endblock javascript %}

{% endblock body %}