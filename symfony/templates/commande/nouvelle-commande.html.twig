{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/commande.css">
{% endblock stylesheets %}

{% block title %} Nouvelle commande {% endblock title %}

{% block content %}

    <div class="divDetailCommande">

        <h3>Nouvelle commande</h3>
        
        <p>Menu choisi : <b><span class="color">{{ menu.titre }}</span></b></p>
        <p>Boîte à repas minimum : <b><span class="color">{{ menu.personneMini }}</span></b></p>
        
        <p>Nom : <b>{{ utilisateur.nom }}</b></p>
        <p>Prenom : <b>{{ utilisateur.prenom }}</b></p>
        <p>Email : <b>{{ utilisateur.email }}</b></p>
        <p>Telephone : <b>{{ utilisateur.telephone }}</b></p>
        
        {% for label, messages in app.flashes %}
            {% for message in messages %}

                <div class="flash-{{ label }}">
                    {{ message }}
                </div>

            {% endfor %}
        {% endfor %}

    </div>
    <section class="sectionFormulaire">

        <div class="messages">
            <p id="prix"></p>
            <p id="prixTotalLivraison"></p>
        </div>

        <div class="divFormulaireCommande">
            
            {{ form_start(form, {
                attr: {
                    id: 'form_commande'
                }
            }) }}
            
            {# Nombre de boîte à repas #}
            {{ form_label(form.nbPersonne) }}
            {{ form_widget(form.nbPersonne, {
                attr: {
                    'data-prix': menu.prixPersonne,
                    'data-min': menu.personneMini,
                    'data-max': menu.qttRestante,
                }
            }) }}
            
            {# Date de livraison #}
            {{ form_label(form.datePrestation) }}
            {{ form_widget(form.datePrestation) }}
            
            {# Heure de livraison #}
            {{ form_label(form.heureLivraison) }}
            {{ form_widget(form.heureLivraison) }}
            {{ form_errors(form.heureLivraison) }}
            
            {# Ville #}
            {{ form_label(form.villeLivraison) }}
            {{ form_widget(form.villeLivraison) }}
            
            {# Adresse #}
            {{ form_label(form.adresseLivraison) }}
            {{ form_widget(form.adresseLivraison) }}
            
            <button type="submit">Enregistrer</button>
            <a href="{{ path('app_menu_detail', {id: menu.id}) }}">Retour aux détails</a>
            
            {{ form_end(form) }}

        </div>  
            
    </section>

{% endblock content %}

{% block javascripts %}
    {{ parent() }}

    <script>
        const calculLivraisonUrl = "{{ path('app_calcul_livraison') }}";
    </script>

    <script src="/javascript/pages/commande.js" defer></script>
{% endblock javascripts %}