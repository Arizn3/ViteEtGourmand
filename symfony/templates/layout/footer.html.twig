<h4>Horaires</h4>

<div>
    <a href="{{ path('app_home_conditions_mention') }}">Conditions Générale et Mention Légales</a>
</div>

<table>
    {% for h in horaires() %}
    <tr>
        <td>{{ h.jour }}</td>
        <td>{{ h.heureOuverture|date('H:i') }}</td>
        <td>-</td>
        <td>{{ h.heureFermeture|date('H:i') }}</td>
    </tr>
    {% endfor %}
</table>