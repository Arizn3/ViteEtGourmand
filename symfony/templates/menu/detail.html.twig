{% extends "base.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/menu.css">
{% endblock stylesheets %}

{% block title %} Détail d'un menu {% endblock title %}

{% block content %}

    <div class="mainMenu">
        {% set plat = menu.plats|first %}
        {% set allAllergenes = [] %}
        <img src="/uploads/plats/{{plat.photo}}" alt="{{ plat.nomPlat }}" width="30%">
        <div class="divMenu">
            <h3>{{ menu.titre }}</h3>
            <p>Thème : {{ menu.theme.description }}</p>
            <p>Régime : {{ menu.regime.description }}</p>
            {% for plat in menu.plats %}
                <p>{{ plat.nomPlat }}</p>
            {% endfor %}
            <p>{{ menu.description }}</p>
            {% for plat in menu.plats %}
                {% for allergene in plat.allergenes %}
                    {% if allergene.description not in allAllergenes %}
                        {% set allAllergenes = allAllergenes|merge([allergene.description]) %}
                    {% endif %}
                {% endfor %}
            {% endfor %}
            <p>Allergènes présents :</p>
            <ul>
                {% for a in allAllergenes %}
                    <li>{{ a }}</li>
                {% endfor %}
            </ul>
            <p>● {{ menu.prixPersonne }}€ par personne</p>
            <p>● À partir de {{ menu.personneMini }} boîte à repas</p>
            <p>{{ menu.qttRestante }} quantités disponibles</p>
            <a href="/menu">Liste des menus</a>
            <a href="{{ path('app_commande', {id: menu.id}) }}">Commander</a>
        </div>
    </div>

{% endblock content %}