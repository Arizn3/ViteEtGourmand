{% extends 'base.html.twig' %}

{% block title %}Menus{% endblock %}

{% block body %}

<main>
    <h2>Ce que nous vous proposons</h2>
    {# Boucle FOR IN qui itère dans l'objet qui est en fait l'Entité Menu #}
    {% for menu in menus %}
    <div>
        <p>{{ menu.titre }}</p>
        <p>{{ menu.description }}</p>
        <p>{{ menu.prixPersonne }}</p>
        <p>{{ menu.personneMini }}</p>
        <a href="{{ path('app_menu_detail', {id: menu.id}) }}">Détail du menu</a>
    </div>
    {% else %}
    <p>Aucun menu disponible</p>
    {% endfor %}
</main>

{% endblock %}