{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/menus.css">
{% endblock stylesheets %}

{% block title %}Nos menus{% endblock title %}

{% block content %}

    {% if utilisateur %}
        <h3>Bonjour {{ utilisateur.prenom }}</h3>
    {% else %}
        <h3>Vous devez être connecté pour passer commande</h3>
    {% endif %}

    {# Filtre #}
    <section class="filtres">

        <input type="number" id="prixMax" placeholder="Prix max. par personne">
        
        <select id="theme">
            <option value="">Tous les thèmes</option>
            {% for theme in themes %}
                <option value="{{ theme.id }}">{{ theme.description }}</option>
            {% endfor %}
        </select>
        
        <select id="regime">
            <option value="">Tous les régimes</option>
            {% for regime in regimes %}
                <option value="{{ regime.id }}">{{ regime.description }}</option>
            {% endfor %}
        </select>
        
        <input type="number" id="nbPersonne" placeholder="Boîte à repas">
        
    </section>

        <h2>Ce que nous vous proposons actuellement</h2>

    {# Menus #}
    <div class="divMenus" id="menuList">

        <button id="btnPrecedent" class="btnPrecedent">⬅️</button>

        {% for menu in menus %}

        <a href="{{ path('app_menu_detail', {id: menu.id}) }}" class="carteMenu">

            <div class="divMenu">

                <p>{{ menu.titre }}</p>
                {% set plat = menu.plats|first %}
                <img src="/uploads/plats/{{plat.photo}}" alt="{{ plat.nomPlat }}" width="100%">
                <p>► {{ menu.prixPersonne }}€ par personne</p>
                <p>► À partir de {{ menu.personneMini }} boîte à repas</p>

            </div>
        </a>
            
        {% else %}

            <p>Aucun menu disponible</p>

        {% endfor %}

        <button id="btnSuivant" class="btnSuivant">➡️</button>

    </div>

{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    <script src="/javascript/pages/menus.js"></script>
{% endblock javascripts %}