{% extends 'base.html.twig' %}

{% block title %} Espace Administrateur {% endblock %}

    {% block stylesheets %}
        {{ parent() }}
        <link rel="stylesheet" href="/css/admin.css">
    {% endblock %}

{% block body %}

    <main class="mainAdmin">
        <h1>Statistiques ({{ periode }})</h1>
        <form method="get">
            <label for="periode">Période :</label>
            <input type="month" name="periode" value="{{ periode }}">
            <button type="submit">Valider</button>
        </form>
        {% if labels is empty %}
            <p>Aucunes statistiques pour cette période</p>
        {% else %}
            <section class="chartContainer">
                <div class="chartDiv">
                    <canvas id="chart"
                    data-labels='{{ labels|json_encode|raw }}'
                    data-values='{{ values|json_encode|raw }}'>
                </canvas>
            </div>
            <div class="stats">
                <p>Total commandes pour la période du {{ periode }} : {{ values|reduce((carry, v) => carry + v ) }}</p>
                <ul>
                    {% for i in 0..labels|length -1 %}
                    <li>{{ labels[i] }} : {{ values[i] }} commandes ({{ revenues[i] }}€)</li>
                    {% endfor %}
                </ul>
                <p>Total chiffre d'affaire du mois : {{ totalCA|number_format(2, ',', ' ') }} €</p>
            </div>
        </section>
    {% endif %}
    </main>

    {% block javascripts %}
        {{ parent() }}
        {# Chart.js #}
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        {# Script JS #}
        <script src="/javascript/chart.js"></script>
    {% endblock %}

{% endblock %}