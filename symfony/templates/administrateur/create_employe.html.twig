{% extends 'base.html.twig' %}

{% block title %} Création d'un nouveau compte employé {% endblock %}

    {% block stylesheets %}
        {{ parent() }}
        {# <link rel="stylesheet" href="/css/"> #}
    {% endblock %}

{% block body %}

    <main>

        <h3>Nouveau compte employé</h3>
        <br><br>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        <form method="post">
            <label for="email">Indiquer un email :</label>
            <input type="email" name="email" required>
            <label for="prenom">Prenom :</label>
            <input type="text" name="prenom" required>
            <label for="nom">Nom :</label>
            <input type="text" name="nom" required>
            <button type="submit">Valider</button>
        </form>

        <br><br>
        <h3>Liste des comptes actifs</h3>

        {% for supp, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-{{ supp }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <table>
            <tr>
                <th>Email</th>
                <th>Nom</th>
                <th>Prenom</th>
            </tr>
            {% for comptes in compte %}
                <tr>
                    <td>{{ comptes.email }}</td>
                    <td>{{ comptes.nom }}</td>
                    <td>{{ comptes.prenom }}</td>
                    <td>
                        <a href="{{ path('app_suppression_employe', {id: comptes.id}) }}" class="btn-supression">❌</a>
                    </td>
                </tr>
            {% endfor %}
        </table>

    </main>

    {% block javascripts %}
        <script src="/javascript/admin-employe.js"></script>
    {% endblock %}

{% endblock %}