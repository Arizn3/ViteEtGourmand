            <a href="{{ path('app_employe_avis') }}">Avis</a>
            <a href="{{ path('app_employe_horaire') }}">Horaire</a>
        </div>
    </div>
{% endif %}

{# ESPACE ADMINISTRATEUR #}
{% if app.user and is_granted('ROLE_ADMIN') %}
    <div class="navAdministrateur">
        <a href="{{ path('app_administrateur_stat') }}">Espace Administrateur</a>
    </div>
{% endif %}

{# CONTACT #}
