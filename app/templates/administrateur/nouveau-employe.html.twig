{% extends 'base.html.twig' %}

{% block title %} Création d'un nouveau compte employé {% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/admin/admin-compte-employe.css">
{% endblock stylesheets %}

{% block content %}

    <div class="formulaireEmploye">

        <h3>Nouveau compte employé</h3>
        
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        
        <form method="post">
            <label for="email" class="labelEmail">Indiquer un email :</label>
            <input type="email" name="email" class="emailEmploye" required>
            <label for="prenom">Prenom :</label>
            <input type="text" name="prenom" class="prenomEmploye" required>
            <label for="nom">Nom :</label>
            <input type="text" name="nom" class="nomEmploye" required>
            <button type="submit">Valider</button>
        </form>
        
    </div>

    <div class="listeEmploye">

        <h3>Liste des comptes actifs</h3>
        
        {% for supp, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-{{ supp }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        
        <table>
            <tr>
                <th>Email</th>
                <th>Nom</th>
                <th>Prenom</th>
            </tr>
            {% for comptes in compte %}
            <tr>
                <td class="emailEmploye">{{ comptes.email }}</td>
                <td class="nomEmploye">{{ comptes.nom }}</td>
                <td class="prenomEmploye">{{ comptes.prenom }}</td>
                <td>
                    <a href="{{ path('app_suppression_employe', {id: comptes.id}) }}" class="btn-supression">❌</a>
                </td>
            </tr>
            {% endfor %}
        </table>
        
    </div>

{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    <script src="/javascript/pages/admin/admin-employe.js"></script>
{% endblock javascripts %}