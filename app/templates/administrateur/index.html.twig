{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/admin/admin.css">
{% endblock stylesheets %}

{% block title %} Espace Administrateur - Statistiques {% endblock title %}

{% block content %}

    <div>

        <div class="titrePeriode">

            <h3>Statistiques ({{ periode }})</h3>
            
            <form method="get">
                <label for="periode">Période :</label>
                <input type="month" name="periode" value="{{ periode }}">
                <button type="submit">Valider</button>
            </form>
            
        </div>

        {% if labels is empty %}
            <p>Aucunes statistiques pour cette période</p>
        {% else %}

            <section class="chartContainer">

                <div class="chartDiv">
                    <canvas id="chart"
                        data-labels='{{ labels|json_encode|raw }}'
                        data-values='{{ values|json_encode|raw }}'>
                    </canvas>
                </div>

                <div class="stats">
                    <p>Total commandes pour la période du {{ periode }} : <span class="ttCommande">{{ values|reduce((carry, v) => carry + v ) }}</span></p>
                    <ul>
                    {% for i in 0..labels|length -1 %}
                    <li>{{ labels[i] }} : {{ values[i] }} commandes ( <span class="revenues">{{ revenues[i] }}€</span> )</li>
                    {% endfor %}
                    </ul>
                    <p>Total chiffre d'affaire du mois : <span class="ca">{{ totalCA|number_format(2, ',', ' ') }} €</span></p>
                </div>

            </section>

        {% endif %}

    </div>

{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    {# Chart.js #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    {# Script JS #}
    <script src="/javascript/pages/admin/graph.js"></script>
{% endblock javascripts %}