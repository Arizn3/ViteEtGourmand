{% extends 'base.html.twig' %}

{% block title %} Modifier un menu {% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/pages/employe/employe-modification-menu.css">
{% endblock stylesheets %}

{% block content %}

    {# Nom du compte employé connecté #}
    <p> Compte : {{ app.user.userIdentifier }}</p>

    <div class="divTitre">

        <h3>Modifier un menu</h3>

        <a href="{{ path('app_employe_gestion_menu') }}">Gestion des menus</a>

    </div>

    <section class="formulaire">

        {{ form_start(form) }}
        
        {# Date #}
        <p>Date de création du menu : <b><span class="colorDate">{{ menu.createdAt|date('d/m/Y') }}</span></b></p>
        {{ form_errors(form.plats) }}

        {# Nom du menu #}
        {{ form_label(form.titre) }}
        {{ form_widget(form.titre) }}

        {# Choix du thème #}
        {{ form_label(form.theme) }}
        {{ form_widget(form.theme) }}

        {# Menu dipsponible à partir de X personnes #}
        {{ form_label(form.personneMini) }}
        {{ form_widget(form.personneMini) }}

        {# Prix par personne #}
        {{ form_label(form.prixPersonne) }}
        {{ form_widget(form.prixPersonne) }}

        {# Description #}
        {{ form_label(form.description) }}
        {{ form_widget(form.description) }}

        {# Quantité restante #}
        {{ form_label(form.qttRestante) }}
        {{ form_widget(form.qttRestante) }}

        {# Choix du régime #}
        {{ form_label(form.regime) }}
        {{ form_widget(form.regime) }}

        {# Choix des plats #}
        <p>Veuillez sélectionner au moins 3 plats</p>
        <div class="listePlats">
            {% for plat in form.plats %}
                <label class="plat">
                    {{ form_widget(plat) }}
                    <span>
                        {{ plat.vars.label }}
                    </span>
                </label>
            {% endfor %}
        </div>

        <button type="submit">Enregistrer</button>

        {{ form_end(form) }}

    </section>

{% endblock content %}