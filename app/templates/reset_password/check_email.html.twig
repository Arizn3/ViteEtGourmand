<head>
    <title> Courriel de réinitialisation du mot de passe envoyé </title>
    <link rel="stylesheet" href="/css/pages/home/check-email.css">
    <link rel="icon" href="/uploads/images/logo.png">
</head>

<body>
    <main>

        <h1>Vite<span class="et">&</span>Gourmand</h1>
        <p class="pouce">👍🏼</p>
        <p>
